generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Supplier {
  id              Int        @id @default(autoincrement())
  code            String     @unique
  name            String
  nameEn          String?
  productName     String?
  productNameEn   String?
  address         String?
  addressEn       String?
  taxCode         String?
  storage         String?
  storageEn       String?
  shelfLife       String?
  shelfLifeEn     String?
  sourceUrl       String?
  legacyDocsUrl   String?
  status          String     @default("ACTIVE")
  verificationStatus String  @default("PENDING")
  notes           String?
  notesEn         String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  documents       Document[]
  auditLogs       AuditLog[]
  products        Product[]

  @@index([code])
  @@index([name])
}

model Document {
  id          Int       @id @default(autoincrement())
  supplierId  Int
  title       String
  titleEn     String?
  category    String    @default("OTHER")
  fileUrl     String
  issuedAt    DateTime?
  expiresAt   DateTime?
  status      String    @default("VALID")
  isPublic    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  supplier    Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  versions    DocumentVersion[]

  @@index([supplierId])
  @@index([expiresAt])
}

model DocumentVersion {
  id          Int       @id @default(autoincrement())
  documentId  Int
  fileUrl     String
  note        String?
  createdAt   DateTime  @default(now())
  document    Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model AuditLog {
  id          Int       @id @default(autoincrement())
  supplierId  Int?
  action      String
  entity      String
  entityId    String?
  summary     String
  createdAt   DateTime  @default(now())
  supplier    Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([supplierId])
  @@index([createdAt])
}

model ImportDraft {
  id          Int       @id @default(autoincrement())
  code        String
  sourceUrl   String
  sourceHash  String
  payload     String
  status      String    @default("PENDING")
  fetchedAt   DateTime  @default(now())
  reviewedAt  DateTime?
  reviewNotes String?

  @@index([code, fetchedAt])
}

model AiIntegrationSettings {
  id              Int      @id @default(1)
  encryptedApiKey String?
  documentModel   String   @default("gpt-5.6-terra")
  helperModel     String   @default("gpt-5.6-luna")
  publicQaEnabled Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

model Product {
  id         Int       @id @default(autoincrement())
  supplierId Int
  name       String
  sku        String?
  gtin       String?
  origin     String?
  unit       String?
  storage    String?
  isPublic   Boolean   @default(false)
  supplier   Supplier  @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  batches    Batch[]

  @@index([supplierId])
}

model Batch {
  id         Int          @id @default(autoincrement())
  publicId   String       @unique @default(cuid())
  productId  Int
  code       String
  receivedAt DateTime?
  producedAt DateTime?
  expiresAt  DateTime?
  sourceSystem String @default("LOCAL")
  sourceKey String? @unique
  sourceSyncedAt DateTime?
  everPublished Boolean @default(false)
  isPublic   Boolean      @default(false)
  product    Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  events     TraceEvent[]

  @@unique([productId, code])
}

model TraceEvent {
  id         Int      @id @default(autoincrement())
  batchId    Int
  occurredAt DateTime
  stage      String
  title      String
  details    String?
  location   String?
  isPublic   Boolean  @default(false)
  batch      Batch    @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([batchId, occurredAt])
}
