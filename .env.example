DATABASE_URL="file:./prisma/dev.db"
NEXT_PUBLIC_SITE_URL="http://localhost:3010"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-local"
AUTH_SECRET="replace-with-a-long-random-secret-before-production"
# Tuỳ chọn: khóa mã hóa riêng cho API key lưu qua trang quản trị. Nếu bỏ trống, dùng AUTH_SECRET.
INTEGRATION_ENCRYPTION_KEY=""
UPLOAD_DIR="./storage/uploads"

# Tuỳ chọn: cấu hình qua /admin/settings/ai; các biến dưới đây là dự phòng phía server.
OPENAI_API_KEY=""
OPENAI_DOCUMENT_MODEL="gpt-5.6-terra"
OPENAI_QA_MODEL="gpt-5.6-luna"
AI_PUBLIC_QA_ENABLED="false"
